# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form letters
CONTACT_TO_EMAIL=

# Optional sender. Must use a domain verified in Resend, e.g.
# "Portfolio Mail Room <mail@yourdomain.com>".
# Leave empty to use Resend's sandbox sender (onboarding@resend.dev),
# which can only deliver to the email address of your Resend account.
CONTACT_FROM_EMAIL=

# Upstash Redis for contact-form rate limiting (3 letters / 10 min per IP).
# https://console.upstash.com → create a Redis database → "REST API" tab.
# Vercel's Upstash integration names (KV_REST_API_URL / KV_REST_API_TOKEN) also work.
# Leave empty to disable rate limiting (fine for local development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
